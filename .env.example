APP_NAME=phuonghihi
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL="${APP_URL}/vnpay/return"

# Thông tin cửa hàng — dùng cho trang liên hệ và dữ liệu Store gửi tới Google.
# Bỏ dấu # và điền giá trị thật khi lên tên miền; để nguyên thì lấy mặc định
# trong config/shop.php. Không để "SHOP_PHONE=" trống, vì giá trị rỗng sẽ ghi
# đè mặc định thành chuỗi rỗng.
#SHOP_LEGAL_NAME="phuonghihi"
#SHOP_PHONE="0900 300 300"
#SHOP_EMAIL="hotro@phuonghihi.example"
#SHOP_STREET="123 Đường Lê Lợi"
#SHOP_DISTRICT="Quận 1"
#SHOP_CITY="TP. Hồ Chí Minh"
#SHOP_OPENING_HOURS="8:00 - 21:00, tất cả các ngày trong tuần"
#SHOP_OPENING_HOURS_SCHEMA="Mo-Su 08:00-21:00"
